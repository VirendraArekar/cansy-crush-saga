# Application Environment Configuration Example

# Frontend
VITE_API_URL=http://localhost:8080/api

# Backend Server
PORT=8080

# Spring Profiles: default (in-memory H2) or docker (PostgreSQL + Redis)
SPRING_PROFILES_ACTIVE=default

# PostgreSQL Database (Docker profile)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sugarcascade
SPRING_DATASOURCE_USERNAME=sugar_user
SPRING_DATASOURCE_PASSWORD=sugar_password

# Redis Configuration
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# JWT Security
APP_JWT_SECRET=sugar-cascade-super-secure-production-jwt-token-secret-key-candy-match3-quest-2026
APP_JWT_EXPIRATION_MS=86400000

# Gameplay & Rewards Defaults
APP_REWARDS_DAILY_LOGIN_COINS=250
APP_REWARDS_DAILY_LOGIN_LIVES=2
APP_REWARDS_LIFE_REGEN_INTERVAL_MINUTES=30
APP_REWARDS_MAX_LIVES=5
